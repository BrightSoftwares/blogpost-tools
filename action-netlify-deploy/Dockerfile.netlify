FROM node:22-slim

# Pinned (was unpinned `npm i -g netlify-cli` on EOL node:current-stretch-slim).
# netlify-cli 27.x requires node >=22.13. Bump deliberately, verify via workflow_dispatch.
ARG NETLIFY_CLI_VERSION=27.11.0
RUN npm i -g netlify-cli@${NETLIFY_CLI_VERSION} && npm cache clean --force

ADD entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ADD action.yml /action.yml

ENTRYPOINT ["/entrypoint.sh"]
